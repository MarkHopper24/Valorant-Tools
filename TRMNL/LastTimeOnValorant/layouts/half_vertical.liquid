<div class="layout layout--col val compact vertical portrait:gap--small"><div class="masthead"><div><div class="eyebrow">Last time on</div><div class="wordmark">VALORANT</div></div><div class="identity"><strong>{{ players_label | escape }}</strong><br>{{ items.size }} MATCH REWIND · NEWEST FIRST</div></div>{% if stale or checked_at and age_s > 10800 %}<div class="label label--inverted">Update delayed · showing last known matches</div>{% endif %}{% if status == 'error' %}<div class="title" data-clamp="2">Match feed unavailable</div><div class="description">Last successful check: {{ checked_label | default: 'not yet checked' | escape }}</div>{% elsif status == 'loading' %}<div class="title">Loading the recap…</div>{% elsif items.size == 0 or items == nil %}<div class="title">The next story starts in queue.</div><div class="description">No finished matches available yet.</div>{% else %}<div class="episodes" data-overflow="true">{% for m in items limit: 3 %}<article class="episode"><div class="topline"><span>0{{ forloop.index }} / {{ m.mode | escape }}</span><span>{{ m.date | escape }}</span></div><div class="maprow"><div class="val-map" data-clamp="1">{{ m.map | escape }}</div><div class="scoreline"><span class="score value--tnums">{{ m.score | escape }}</span><span class="result">{{ m.result | escape }} {{ m.score_label | escape }}</span></div></div><div class="headline" data-clamp="2">{{ m.headline | escape }}</div><div class="story" data-clamp-md="3" data-clamp-lg="6" data-clamp="3">{{ m.short | escape }}</div><div class="roster">{% for p in m.players %}<div class="player"><strong>{{ p.name | escape }} <span class="detail">{{ p.agent | escape }}</span></strong>{% if p.present %}<span class="kda">{{ p.kda | escape }}</span><span class="detail">{{ p.acs }} ACS · {{ p.hs }}% HS</span><span class="detail">K / D / A</span>{% else %}<span class="detail">Not in match</span>{% endif %}</div>{% endfor %}</div></article>{% endfor %}</div>{% endif %}</div><div class="title_bar"><span class="title">Last time on Valorant</span><span class="instance">Checked {{ checked_label | default: 'pending' | escape }} {{ timezone | escape }}</span></div>