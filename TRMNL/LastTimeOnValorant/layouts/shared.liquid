<style>
.val{align-items:stretch!important;justify-content:flex-start!important;gap:16px!important;text-align:left;min-height:0;font-family:var(--title-font-family,Arial,sans-serif);color:var(--framework-semantic-text-primary-text-color,currentColor)}
