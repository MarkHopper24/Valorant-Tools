<div class="layout layout--col val lg:gap--large portrait:gap--small"><div class="masthead"><div><div class="eyebrow">Last time on</div><div class="wordmark">VALORANT</div></div><div class="identity"><strong>{{ players_label | escape }}</strong><br>{{ items.size }} MATCH REWIND · NEWEST FIRST</div></div>{% if stale or checked_at and age_s > 10800 %}<div class="label label--inverted">Update delayed · showing last known matches</div>{% endif %}{% if status == 'error' %}<div class="title" data-clamp="2">Match feed unavailable</div><div class="description">Last successful check: {{ checked_label | default: 'not yet checked' | escape }}</div>{% elsif status == 'loading' %}<div class="title">Loading the recap…</div>{% elsif items.size == 0 or items == nil %}<div class="title">The next story starts in queue.</div><div class="description">No finished matches available yet.</div>{% else %}<div class="episodes">{% for m in items limit: 3 %}<article class="episode"><div class="topline"><span>0{{ forloop.index }} / {{ m.mode | escape }}</span><span>{{ m.date | escape }}</span></div><div class="maprow"><div class="val-map" data-clamp="1">{{ m.map | escape }}</div><div class="scoreline"><span class="score value--tnums">{{ m.score | escape }}</span><span class="result">{{ m.result | escape }} {{ m.score_label | escape }}</span></div></div><div class="headline" data-clamp="2">{{ m.headline | escape }}</div><div class="story" data-clamp-md="3" data-clamp-lg="6" data-clamp="6">{{ m.commentary | escape }}</div><div class="roster">{% for p in m.players %}<div class="player"><strong>{{ p.name | escape }} <span class="detail">{{ p.agent | escape }}</span></strong>{% if p.present %}<span class="kda">{{ p.kda | escape }}</span><span class="detail">{{ p.acs }} ACS · {{ p.hs }}% HS</span><span class="detail">K / D / A</span>{% else %}<span class="detail">Not in match</span>{% endif %}</div>{% endfor %}</div></article>{% endfor %}</div><div class="chart-row">{% assign metrics = 'kills,acs' | split: ',' %}{% for metric in metrics %}<section><div class="chart-title"><span>{% if metric == 'kills' %}Kills / match{% else %}Average combat score{% endif %}</span><span class="legend"><span><i class="key" data-chart-series="0" data-chart-series-count="2"></i>{{ player_names[0] | escape }}</span><span><i class="key" data-chart-series="1" data-chart-series-count="2"></i>{{ player_names[1] | escape }}</span></span></div><div class="chart" id="val-{{ metric }}-full">{% for m in items reversed %}<span hidden data-map="{{ m.map | escape }}" data-first="{% if m.players[0].present %}{{ m.players[0][metric] }}{% endif %}" data-second="{% if m.players[1].present %}{{ m.players[1][metric] }}{% endif %}"></span>{% endfor %}</div></section>{% endfor %}</div><div class="footer-note">Charts run oldest → newest. Kills are totals; ACS is per round. Modes and match lengths differ.</div>
<script>(function(){let tries=0;function ready(){if(!window.TRMNLCharts||!window.Highcharts){if(++tries<200)setTimeout(ready,50);return;}['kills','acs'].forEach(function(metric){var el=document.getElementById('val-'+metric+'-full');if(!el)return;var rows=Array.from(el.querySelectorAll('[data-map]')).map(function(r){return {map:r.dataset.map,first:r.dataset.first===''?null:Number(r.dataset.first),second:r.dataset.second===''?null:Number(r.dataset.second)};});TRMNLCharts.watch(el,function(){var px=function(n){return TRMNLPaint.px(n,{el:el});};var chart=Highcharts.chart(el,TRMNLCharts.merge(TRMNLCharts.options({el:el}),{chart:{type:'column',height:el.clientHeight,animation:false,spacing:px([16,8,0,0])},title:{text:null},credits:{enabled:false},accessibility:{enabled:false},legend:{enabled:false},tooltip:{enabled:false},xAxis:{categories:rows.map(function(r){return r.map;}),labels:{style:{fontSize:px(12)+'px'}}},yAxis:{min:0,maxPadding:.18,title:{text:null},tickAmount:3,labels:{style:{fontSize:px(10)+'px'}}},plotOptions:{series:{animation:false,enableMouseTracking:false,borderWidth:0,dataLabels:{enabled:true,crop:false,overflow:"allow",style:{fontSize:px(12)+'px',fontWeight:'bold',textOutline:'none'}},groupPadding:.18,pointPadding:.04}},series:['first','second'].map(function(key,i){return {name:i?'Player 2':'Player 1',data:rows.map(function(r){return r[key];}),color:TRMNLCharts.series(i,2,{el:el})};})}));TRMNLCharts.applySwatches({el:el.closest('.val')});el.dataset.ready='true';return chart;});});}ready();})();</script>{% endif %}</div><div class="title_bar"><span class="title">Last time on Valorant</span><span class="instance">Checked {{ checked_label | default: 'pending' | escape }} {{ timezone | escape }}</span></div>